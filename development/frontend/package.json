{
  "name": "@modules/foodbridge-module-distribution-logistics-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend for the Foodbridge Module Distribution Logistics module. Boots standalone via sandbox/, and is copy-paste-portable into any host React container.",
  "type": "module",
  "scripts": {
    "sandbox": "vite sandbox --config sandbox/vite.config.ts",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:business": "vitest run tests/business",
    "test:behavioural": "vitest run tests/behavioural",
    "test:functional": "vitest run tests/functional",
    "test:integration": "vitest run tests/integration"
  },
  "dependencies": {
    "@foodbridge-module-distribution-logistics/ssot": "file:../sources-of-truth",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "xstate": "^5.0.0",
    "@xstate/react": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0",
    "@testing-library/react": "^16.0.0"
  }
}
